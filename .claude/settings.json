{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npx prisma:*)",
      "Bash(npx shadcn:*)",
      "Bash(npx next:*)",
      "Bash(npx tsc:*)",
      "Bash(node:*)",
      "Bash(docker compose:*)",
      "Bash(curl:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(./.env)"
    ]
  }
}
