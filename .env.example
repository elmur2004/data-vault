# The environment contract. Copy to .env, or just run `npm run doctor` - it creates
# .env from these defaults, generates the secrets, and keeps anything you have changed.
# Never commit .env.

# --- Database ---
# docker-compose.dev.yml serves Postgres on 5432. The no-Docker Windows path uses a
# private cluster on 55432 instead - see docs/LOCAL-DEV-WINDOWS.md.
DATABASE_URL="postgresql://postgres:database@127.0.0.1:5432/database_app?schema=public"

# --- App / auth ---
APP_URL="http://localhost:3001"
BETTER_AUTH_URL="http://localhost:3001"
# `npm run doctor` generates a random one if this is missing.
BETTER_AUTH_SECRET="change-me-32-chars-minimum-random"

# --- The admin account (DF-01) ---
# Fixed on purpose: a clone, a pull or a rebuilt database should never leave anyone
# locked out. `npm run doctor` guarantees this account exists with this password.
# Change both before any deployment that is not a local machine.
SEED_ADMIN_EMAIL="admin@byteforce.com"
SEED_ADMIN_PASSWORD="password123"

# --- File storage ---
# Uploads are written to this directory inside the project. It must NOT be inside
# public/ - anything there is served without authorisation, which breaks BR-14.
# Files are reachable only through a signed link that expires after
# SIGNED_URL_TTL_SECONDS. See docs/FILE-STORAGE.md.
STORAGE_DIR="storage"
SIGNED_URL_TTL_SECONDS="300"   # BR-14: 5 minutes, not negotiable
MAX_UPLOAD_MB="25"             # D-09

# --- Email (Mailpit in dev: UI at http://localhost:8025) ---
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_FROM="Vault <no-reply@local.test>"

# --- Behaviour ---
DISPLAY_TZ="Africa/Cairo"      # BR-15: store UTC, display Cairo
MALWARE_SCAN="off"             # off | clamav  (S-08)
                               # R-10: `off` marks every upload clean. Production must
                               # set clamav - -10.3 is not satisfied otherwise.

# --- Scheduled jobs (DF-02) ---
# The deadline-reminder route requires this as a bearer token.
CRON_SECRET="change-me"
