# Copy to .env and adjust. Never commit .env.

# --- Database (docker-compose.dev.yml postgres) ---
DATABASE_URL="postgresql://postgres:database@localhost:5432/database_app"

# --- App / auth ---
APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="change-me-32-chars-minimum-random"

# --- Object storage (MinIO in dev; R2/S3 in prod) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="database-files"
S3_ACCESS_KEY_ID="local"
S3_SECRET_ACCESS_KEY="localsecret"
S3_FORCE_PATH_STYLE="true"
SIGNED_URL_TTL_SECONDS="300"   # BR-14: 5 minutes
MAX_UPLOAD_MB="25"             # D-09 default

# --- Email (Mailpit in dev: UI at http://localhost:8025) ---
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_FROM="Database <no-reply@local.test>"

# --- Behaviour ---
DISPLAY_TZ="Africa/Cairo"      # BR-15: store UTC, display Cairo
MALWARE_SCAN="off"             # off | clamav  (S-08)
