{
  "name": "vault",
  "version": "0.1.0",
  "private": true,
  "description": "Vault — internal ops registry for ByteForce and B-Systems (Forms, Sheets, Documents, Tasks)",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx --tsconfig tsconfig.scripts.json prisma/seed.ts",
    "db:demo": "tsx --tsconfig tsconfig.scripts.json prisma/demo.ts",
    "db:studio": "prisma studio",
    "storage:init": "tsx --tsconfig tsconfig.scripts.json scripts/init-storage.ts",
    "check": "tsx --tsconfig tsconfig.scripts.json",
    "services:start": "powershell -ExecutionPolicy Bypass -File .devservices/services.ps1 start",
    "services:stop": "powershell -ExecutionPolicy Bypass -File .devservices/services.ps1 stop",
    "services:status": "powershell -ExecutionPolicy Bypass -File .devservices/services.ps1 status"
  },
  "prisma": {
    "seed": "tsx --tsconfig tsconfig.scripts.json prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.678.0",
    "@aws-sdk/s3-request-presigner": "^3.678.0",
    "@better-auth/prisma-adapter": "^1.6.27",
    "@date-fns/tz": "^1.2.0",
    "@hookform/resolvers": "^5.7.1",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.1.0",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tanstack/react-table": "^8.20.6",
    "better-auth": "^1.1.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "file-type": "^19.6.0",
    "lucide-react": "^0.469.0",
    "next": "^15.1.4",
    "next-intl": "^3.26.3",
    "nodemailer": "^6.9.16",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "server-only": "^0.0.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.4",
    "playwright": "^1.49.1",
    "prisma": "^6.1.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
